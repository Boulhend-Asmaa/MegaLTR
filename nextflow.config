/*
 * MegaLTR Nextflow Configuration
 * Phase 6: Production-Ready Workflow
 *
 * This configuration file defines execution profiles, resource limits,
 * and process-specific requirements for the MegaLTR pipeline.
 *
 * Usage:
 *   nextflow run main.nf -profile conda        # Local execution with Conda
 *   nextflow run main.nf -profile slurm,conda  # SLURM with Conda
 *   nextflow run main.nf -profile docker       # Docker containers
 */

// ============================================================================
// MANIFEST
// ============================================================================

manifest {
    name = 'MegaLTR'
    author = 'Asmaa Boulhend'
    homePage = 'https://github.com/Boulhend-Asmaa/MegaLTR'
    description = 'LTR retrotransposon identification and analysis pipeline - Nextflow implementation'
    mainScript = 'main.nf'
    nextflowVersion = '>=21.04.0'
    version = '2.0.0'
}

// ============================================================================
// DEFAULT PARAMETERS
// ============================================================================

params {
    // Input/Output
    genome = null
    gff = null
    outdir = 'megaltr_results'
    prefix = 'results'

    // Analysis configuration
    analysis_type = 3
    trna = 'Arabidopsis_thaliana_trna.fa'

    // LTR detection parameters
    min_ltr_len = 100
    max_ltr_len = 7000
    min_ltr_dist = 1000
    max_ltr_dist = 15000
    similarity = 85
    match_pairs = 20

    // TEsorter parameters
    tesorter_db = 'rexdb'
    tesorter_cov = 20
    tesorter_eval = 0.001
    tesorter_rule = '80-80-80'
    tesorter_hmm = 'rexdb'

    // Insertion time parameters
    mutation_rate = 0.000000015  // Arabidopsis default

    // Gene proximity parameters
    upstream_dist = 5000
    downstream_dist = 5000
    density_window = 1000000
    n_chromosomes = 9

    // Execution resources (HPC-ready defaults for large genomes)
    threads = 16
    max_cpus = 64
    max_memory = '128.GB'
    max_time = '168.h'  // 7 days max for large genome analysis

    // Help flag
    help = false
}

// ============================================================================
// PROCESS CONFIGURATION
// ============================================================================

process {
    // Default error handling
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries = 2
    maxErrors = '-1'

    // Default resources (lightweight processes)
    cpus = { check_max(1, 'cpus') }
    memory = { check_max(4.GB * task.attempt, 'memory') }
    time = { check_max(2.h * task.attempt, 'time') }

    // ========================================================================
    // STAGE 1: Input preparation (fast, low resources)
    // ========================================================================

    withName: 'PREPARE_GENOME' {
        cpus = 1
        memory = { check_max(4.GB, 'memory') }
        time = { check_max(1.h, 'time') }
    }

    withName: 'PREPARE_TRNA' {
        cpus = 1
        memory = { check_max(1.GB, 'memory') }
        time = { check_max(10.m, 'time') }
    }

    withName: 'PREPARE_GFF' {
        cpus = 1
        memory = { check_max(2.GB, 'memory') }
        time = { check_max(30.m, 'time') }
    }

    // ========================================================================
    // STAGE 2: LTR detection (compute-intensive, parallel)
    // ========================================================================

    withName: 'LTR_FINDER' {
        cpus = { check_max(params.threads, 'cpus') }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time = { check_max(24.h * task.attempt, 'time') }

        // LTR_FINDER is memory-intensive for large genomes
        // Scales: 16GB -> 32GB -> 48GB on retries
        errorStrategy = 'retry'
        maxRetries = 3
    }

    withName: 'LTR_HARVEST' {
        cpus = { check_max(params.threads, 'cpus') }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time = { check_max(24.h * task.attempt, 'time') }

        // Suffix array construction requires significant memory for large genomes
        // Scales: 16GB -> 32GB -> 48GB on retries
        errorStrategy = 'retry'
        maxRetries = 3
    }

    withName: 'MERGE_LTR_CANDIDATES' {
        cpus = 1
        memory = { check_max(2.GB, 'memory') }
        time = { check_max(30.m, 'time') }
    }

    // ========================================================================
    // STAGE 3: LTR refinement and domain annotation
    // ========================================================================

    withName: 'LTR_RETRIEVER' {
        cpus = { check_max(params.threads, 'cpus') }
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time = { check_max(48.h * task.attempt, 'time') }

        // LTR_retriever runs RepeatMasker (memory-intensive for large genomes)
        // Scales: 32GB -> 64GB -> 96GB on retries
        errorStrategy = 'retry'
        maxRetries = 3
    }

    withName: 'LTRDIGEST' {
        cpus = { check_max(params.threads / 2, 'cpus') }
        memory = { check_max(8.GB * task.attempt, 'memory') }
        time = { check_max(12.h * task.attempt, 'time') }
    }

    withName: 'TESORTER' {
        cpus = { check_max(params.threads, 'cpus') }
        memory = { check_max(8.GB * task.attempt, 'memory') }
        time = { check_max(8.h * task.attempt, 'time') }
    }

    // ========================================================================
    // STAGE 4: Result integration and sequence extraction
    // ========================================================================

    withName: 'MERGE_RESULTS' {
        cpus = 1
        memory = { check_max(4.GB, 'memory') }
        time = { check_max(1.h, 'time') }
    }

    withName: 'SPLIT_COORDINATES' {
        cpus = 1
        memory = { check_max(2.GB, 'memory') }
        time = { check_max(15.m, 'time') }

        // Phase 5 smart splitting - critical process
        errorStrategy = 'finish'  // Don't retry, must succeed first time
    }

    withName: 'EXTRACT_SEQUENCES' {
        cpus = { check_max(params.threads, 'cpus') }
        memory = { check_max(16.GB, 'memory') }
        time = { check_max(8.h, 'time') }

        // Parallel sequence extraction using Phase 5 chunks
    }

    withName: 'BUILD_NONREDUNDANT_LIBRARY' {
        cpus = { check_max(params.threads, 'cpus') }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time = { check_max(8.h * task.attempt, 'time') }

        // vsearch clustering can be memory-intensive for large datasets
        errorStrategy = 'retry'
        maxRetries = 3
    }

    // ========================================================================
    // STAGE 5: Insertion time analysis
    // ========================================================================

    withName: 'CALCULATE_INSERTION_TIME' {
        cpus = { check_max(params.threads, 'cpus') }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time = { check_max(24.h * task.attempt, 'time') }

        // ClustalW alignments for all LTRs (can be slow for large datasets)
        errorStrategy = 'retry'
        maxRetries = 2
    }

    withName: 'GENERATE_TIME_PLOTS' {
        cpus = 1
        memory = { check_max(4.GB, 'memory') }
        time = { check_max(1.h, 'time') }
    }

    // ========================================================================
    // STAGE 6: Gene association analysis
    // ========================================================================

    withName: 'IDENTIFY_GENE_CHIMERAS' {
        cpus = 1
        memory = { check_max(4.GB, 'memory') }
        time = { check_max(2.h, 'time') }
    }

    withName: 'FIND_NEARBY_GENES' {
        cpus = 1
        memory = { check_max(4.GB, 'memory') }
        time = { check_max(2.h, 'time') }
    }

    withName: 'VISUALIZE_CHROMOSOME_DENSITY' {
        cpus = 1
        memory = { check_max(16.GB, 'memory') }
        time = { check_max(4.h, 'time') }

        // R plotting can require memory for large datasets
    }

    // ========================================================================
    // STAGE 7: ID restoration
    // ========================================================================

    withName: 'RESTORE_IDS' {
        cpus = 1
        memory = { check_max(4.GB, 'memory') }
        time = { check_max(1.h, 'time') }
    }
}

// ============================================================================
// EXECUTION PROFILES
// ============================================================================

profiles {
    // ------------------------------------------------------------------------
    // Standard: Local execution without containers
    // ------------------------------------------------------------------------
    standard {
        process.executor = 'local'
        process.conda = "${projectDir}/MegaLTR.clean.yml"
        conda.enabled = true
    }

    // ------------------------------------------------------------------------
    // Conda: Explicit conda environment activation
    // ------------------------------------------------------------------------
    conda {
        conda.enabled = true
        conda.useMamba = false  // Use conda, not mamba
        process.conda = "${projectDir}/MegaLTR.clean.yml"

        // Ensure conda environment exists
        conda.createTimeout = '1h'
    }

    // ------------------------------------------------------------------------
    // Docker: Containerized execution (requires MegaLTR Docker image)
    // ------------------------------------------------------------------------
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g) --platform linux/amd64'
        process.container = 'megaltr:2.0'  // Update when image is published

        // Disable conda when using Docker
        conda.enabled = false
    }

    // ------------------------------------------------------------------------
    // Singularity: HPC-compatible containerization
    // ------------------------------------------------------------------------
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = '--cleanenv'
        process.container = 'docker://megaltr:2.0'  // Convert Docker image

        // Disable conda when using Singularity
        conda.enabled = false
    }

    // ------------------------------------------------------------------------
    // SLURM: HPC cluster with SLURM workload manager
    // ------------------------------------------------------------------------
    slurm {
        process.executor = 'slurm'
        process.queue = 'normal'

        // IMPORTANT: Update these for your HPC system
        process.clusterOptions = '--account=your_account_name'

        // SLURM-specific settings
        executor {
            name = 'slurm'
            queueSize = 50
            pollInterval = '30 sec'
            submitRateLimit = '10 sec'
        }

        // Combine with conda or singularity
        // Example: nextflow run main.nf -profile slurm,conda
    }

    // ------------------------------------------------------------------------
    // PBS: HPC cluster with PBS/Torque
    // ------------------------------------------------------------------------
    pbs {
        process.executor = 'pbs'
        process.queue = 'batch'

        executor {
            name = 'pbs'
            queueSize = 50
            pollInterval = '30 sec'
        }
    }

    // ------------------------------------------------------------------------
    // LSF: HPC cluster with LSF (IBM Spectrum)
    // ------------------------------------------------------------------------
    lsf {
        process.executor = 'lsf'
        process.queue = 'normal'

        executor {
            name = 'lsf'
            perJobMemLimit = true
            queueSize = 50
        }
    }

    // ------------------------------------------------------------------------
    // SGE: Sun Grid Engine
    // ------------------------------------------------------------------------
    sge {
        process.executor = 'sge'
        process.penv = 'smp'  // Parallel environment name
        process.queue = 'all.q'

        executor {
            name = 'sge'
            queueSize = 50
        }
    }

    // ------------------------------------------------------------------------
    // AWS Batch: Cloud execution on Amazon Web Services
    // ------------------------------------------------------------------------
    awsbatch {
        process.executor = 'awsbatch'
        process.queue = 'megaltr-queue'

        aws {
            region = 'us-east-1'
            batch.cliPath = '/usr/local/bin/aws'
        }

        // Requires Docker container
        docker.enabled = true
        process.container = 'megaltr:2.0'
    }

    // ------------------------------------------------------------------------
    // Test: Quick test profile with reduced resources
    // ------------------------------------------------------------------------
    test {
        params.threads = 8
        params.max_cpus = 12
        params.max_memory = '28.GB'
        params.max_time = '72.h'

        process.executor = 'local'
        process.conda = "${projectDir}/MegaLTR.clean.yml"
        conda.enabled = true
    }

    // ------------------------------------------------------------------------
    // HPC: UM6P SLURM cluster execution
    // ------------------------------------------------------------------------
    hpc {
        params.threads = 16
        params.max_cpus = 56
        params.max_memory = '180.GB'
        params.max_time = '168.h'

        process.executor = 'slurm'
        process.queue = 'compute'
        process.conda = "${projectDir}/conda_env"
        conda.enabled = true

        executor {
            name = 'slurm'
            queueSize = 20
            pollInterval = '30 sec'
            submitRateLimit = '10 sec'
        }
    }
}

// ============================================================================
// RESOURCE CHECKING FUNCTIONS
// ============================================================================

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj as int, params.max_cpus as int)
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}

// ============================================================================
// EXECUTION REPORTS
// ============================================================================

// Timeline report - visualize task durations
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

// Execution report - resource usage and statistics
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

// Trace report - detailed execution trace
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

// DAG visualization - workflow structure
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.svg"
    overwrite = true
}

// ============================================================================
// SINGULARITY/DOCKER CACHE
// ============================================================================

singularity.cacheDir = "${HOME}/.singularity/cache"
docker.cacheDir = "${HOME}/.docker/cache"

// ============================================================================
// WORKDIR CLEANUP
// ============================================================================

// Automatically clean up work directory on successful completion
cleanup = false  // Set to true to enable auto-cleanup

// ============================================================================
// CONDA SETTINGS
// ============================================================================

conda {
    cacheDir = "${HOME}/.conda/nextflow"
    createTimeout = '1 h'
    useMamba = false
}

// ============================================================================
// RESUME SETTINGS
// ============================================================================

// Users should explicitly use -resume flag when needed
// Do not set resume = false here (causes UUID error)

// ============================================================================
// NOTIFICATION SETTINGS
// ============================================================================

notification {
    enabled = false  // Enable if you want email notifications
    to = 'user@example.com'
}

// ============================================================================
// TOWER SETTINGS (Nextflow Tower monitoring)
// ============================================================================

tower {
    enabled = false  // Enable to use Nextflow Tower
    accessToken = ''
    workspaceId = ''
}
